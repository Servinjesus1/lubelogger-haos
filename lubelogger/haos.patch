+    if (window.BASE_URL && !url.startsWith(window.BASE_URL + '/')) return window.BASE_URL + url;
+    return url;
+}
+
+$(document).ready(function () {
+    $.ajaxPrefilter(function (options) {
+        if (options.url && options.url.startsWith('/') && window.BASE_URL) {
+            options.url = resolveBaseUrl(options.url);
+        }
+    });
+});
